# Integrated chat overhaul. Merge selected values into the deployment environment.
CHAT_ENGINE=overhaul
CHAT_LOCAL_ONLY=true
CHAT_MODEL=unsloth/gemma-4-12B-it-qat-GGUF
CHAT_CONTEXT_TOKENS=8192
CHAT_MAX_OUTPUT_TOKENS=512
CHAT_THINKING_DEFAULT=false
CHAT_INFERENCE_CONCURRENCY=1
CHAT_TURN_TIMEOUT_MS=90000
CHAT_COLD_TIMEOUT_MS=180000
CHAT_TOOL_MAX_ROUNDS=3
CHAT_TOOL_MAX_CALLS=5
CHAT_RAW_RETENTION_DAYS=90
CHAT_BACKGROUND_CONCURRENCY=1
CHAT_OBSERVE_PARTICIPANTS=true
CHAT_FOLLOWUP_WINDOW_SECONDS=0

# Existing local orchestrator and Mongo settings are reused. Do not put credentials here.
AI_PROXY_URL=http://127.0.0.1:11230
MONGODB_CONNECTION_STRING=mongodb://127.0.0.1:27017
CHAT_MONGODB_DATABASE=another_elaina
QDRANT_URL=http://127.0.0.1:6333
SEARXNG_URL=http://127.0.0.1:8088

CHAT_EMBEDDING_MODEL=Xenova/multilingual-e5-small
CHAT_EMBEDDING_REVISION=761b726dd34fb83930e26aab4e9ac3899aa1fa78
CHAT_EMBEDDING_DEVICE=cpu
CHAT_EMBEDDING_CACHE=./data/chat-models
CHAT_EMBEDDING_ALLOW_REMOTE_SETUP=false

# Comma-separated explicit private hostnames are needed only when a service uses a DNS name.
CHAT_ALLOWED_INFERENCE_HOSTS=
CHAT_ALLOWED_SERVICE_HOSTS=

# Optional integrated replay adapter, relative to the repository root.
CHAT_EVAL_ADAPTER=
