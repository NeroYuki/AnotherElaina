	"main": "Bot.js",
	"scripts": {
		"do-start": "pm2 start Bot.js",
		"start-lan": "set BOT_ENV=lan && node Bot.js",
		"start-vpn": "set BOT_ENV=vpn && node Bot.js",
		"start-lan-linux": "export BOT_ENV=lan && node Bot.js",
		"start-vpn-linux": "export BOT_ENV=vpn && node Bot.js",
		"test:media": "node --test tests/media.test.js tests/video_prompt.test.js tests/h3.test.js",
		"test:forge": "node --test tests/forge_schema.test.js tests/forge_preview.test.js tests/model_catalog.test.js tests/forge_tiled_upscale.test.js tests/forge_outpaint.test.js tests/anima_inpaint.test.js tests/forge_pid.test.js tests/forge_generation_options.test.js tests/forge_reference.test.js tests/forge_session.test.js tests/forge_image_command.test.js tests/forge_image_job.test.js tests/forge_progress.test.js tests/moss_layout.test.js tests/layout_store.test.js tests/layout_agent.test.js",
		"test:image": "node --test tests/image_prompt.test.js tests/image_prompt_batch.test.js tests/image_prompt_commands.test.js tests/layout_command.test.js",
		"test:chat": "node --test tests/chat/**/*.test.js tests/chat/*.test.js",
		"test:chat:integration": "node --test tests/chat/integration/**/*.test.js",
		"chat:eval:local": "node scripts/chat/evaluate.cjs",
		"chat:smoke:local": "node scripts/chat/smoke_local.cjs",
		"chat:smoke:remote": "node scripts/chat/smoke_local.cjs --strict --remote",
		"chat:smoke:subsystem": "node scripts/chat/smoke_subsystem.cjs",
		"chat:migrate": "node scripts/chat/migrate.cjs",
		"chat:jobs": "node scripts/chat/jobs.cjs",
		"chat:reindex": "node scripts/chat/reindex.cjs",
		"chat:ingest": "node scripts/chat/ingest_lore.cjs",
		"chat:setup:embedding": "node scripts/chat/setup_embedding.cjs"
	},
