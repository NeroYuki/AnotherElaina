{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anotherelaina.local/schemas/chat/memory.json",
  "title": "Evidence-backed memory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "memoryId", "kind", "statement", "status", "confidence", "scope", "sourceTurnIds", "evidence", "derivationKey", "derivationVersion", "deletionEpoch", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "memoryId": { "$ref": "#/$defs/id" },
    "kind": { "$ref": "#/$defs/kind" },
    "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "factType": { "enum": ["identity", "trait", "occupation", "action", "decision", "feeling", "location", "ownership", "state", "other"] },
    "subjectCharacterId": { "type": "string", "maxLength": 128 },
    "targetCharacterId": { "type": "string", "maxLength": 128 },
    "userId": { "type": "string", "maxLength": 64 },
    "action": { "type": "string", "maxLength": 1000 },
    "due": { "$ref": "#/$defs/due" },
    "promiseStatus": { "enum": ["open", "fulfilled", "broken", "cancelled"] },
    "planStatus": { "enum": ["proposed", "accepted", "completed", "cancelled"] },
    "acceptedByCharacterIds": { "type": "array", "uniqueItems": true, "maxItems": 50, "items": { "$ref": "#/$defs/id" } },
    "relationType": { "type": "string", "maxLength": 100 },
    "targetMemoryId": { "$ref": "#/$defs/id" },
    "correctionType": { "enum": ["supersede", "retract", "conflict"] },
    "status": { "enum": ["candidate", "active", "superseded", "retracted", "deleted"] },
    "confidence": { "enum": ["explicit", "inferred", "uncertain"] },
    "scope": { "$ref": "#/$defs/scope" },
    "sourceTurnIds": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["turnId", "quote"], "properties": { "turnId": { "$ref": "#/$defs/id" }, "quote": { "type": "string", "minLength": 1, "maxLength": 4000 } } } },
    "salience": { "type": "integer", "minimum": 0, "maximum": 5 },
    "supersedesMemoryId": { "$ref": "#/$defs/id" },
    "supersededByMemoryId": { "$ref": "#/$defs/id" },
    "derivationKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "derivationVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "deletionEpoch": { "type": "integer", "minimum": 0 },
    "createdAt": { "$ref": "#/$defs/date" },
    "updatedAt": { "$ref": "#/$defs/date" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "enum": ["scene_fact", "object_state", "character_fact", "relationship_event", "promise", "plan", "user_preference", "correction", "conflict"] },
    "due": { "type": "object", "additionalProperties": false, "required": ["clock", "value"], "properties": { "clock": { "enum": ["fictional", "real"] }, "relativeToTurnId": { "$ref": "#/$defs/id" }, "value": { "type": "string", "minLength": 1, "maxLength": 200 } } },
    "scope": { "type": "object", "additionalProperties": false, "required": ["guildId", "continuityId"], "properties": { "guildId": { "type": "string", "maxLength": 64 }, "continuityId": { "$ref": "#/$defs/id" }, "sceneId": { "$ref": "#/$defs/id" }, "branchId": { "$ref": "#/$defs/id" }, "audienceUserIds": { "type": "array", "uniqueItems": true, "maxItems": 1000, "items": { "type": "string", "maxLength": 64 } }, "corpus": { "enum": ["memory", "global_lore", "restricted_lore"] } } },
    "date": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "object" }] }
  }
}
